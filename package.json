{
  "name": "taskflow",
  "version": "1.0.0",
  "description": "PostgreSQL-backed task manager: lists, priorities, due dates, filters and inline editing. Express + EJS + pg.",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "db:setup": "node --env-file-if-exists=.env scripts/setup-db.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
